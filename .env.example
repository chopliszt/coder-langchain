# Copiá este archivo como .env en la RAÍZ del repo y completá las keys.

# --- Proveedor de LLM (gemini | openai | anthropic) ---
PROVEEDOR_LLM=gemini
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Modelos (obligatorios: el código no trae nombres de modelos escritos)
MODELO_PRINCIPAL=gemini-flash-lite-latest
MODELO_DE_RESPALDO=gemini-2.5-flash-lite
# OpenAI:    MODELO_PRINCIPAL=gpt-4.1-mini       MODELO_DE_RESPALDO=gpt-4o-mini
# Anthropic: MODELO_PRINCIPAL=claude-haiku-4-5   MODELO_DE_RESPALDO=claude-sonnet-4-5
PEDIDOS_POR_MINUTO_AL_LLM=12

# --- RAG (Chroma local + embeddings locales, gratis) ---
MODELO_DE_EMBEDDINGS=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
NOMBRE_DE_LA_COLECCION=documentos_del_puesto
# Perfil que lee el Entrevistador. Por defecto el ficticio; el real va en data_privada/ (no se sube).
RUTA_DEL_PERFIL_DEL_CANDIDATO=data/perfil_ficticio.md

# --- Persistencia (checkpointer de LangGraph) ---
REDIS_URL=redis://localhost:6379

# --- Observabilidad (LangSmith) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=entrevistador-de-postulaciones

# --- Pre-entrega 4 (Pinecone), no la usa el proyecto final ---
PINECONE_API_KEY=
INDEX_NAME=
