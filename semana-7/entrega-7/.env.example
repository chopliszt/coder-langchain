# Proveedor de LLM: gemini (key gratis en https://aistudio.google.com/apikey) | openai | anthropic
PROVEEDOR_LLM=gemini
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PEDIDOS_POR_MINUTO_AL_LLM=12

# Redis (estado de los trabajos + checkpoints de LangGraph)
REDIS_URL=redis://localhost:6379

# Observabilidad (LangSmith, cuenta gratis en https://smith.langchain.com)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=orquestador-postulaciones
